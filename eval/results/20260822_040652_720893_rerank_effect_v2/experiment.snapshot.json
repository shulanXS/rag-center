    "index_version": "v2",
    "profile": "custom",
    "top_k": 10,
    "retrieval_options": {
      "mode": "hybrid",
      "vector_top_k": 20,
      "bm25_top_k": 20,
      "rrf_k": 10
    },
    "rerank_options": {
      "enabled": false,
      "top_n": 10
    },
    "evidence_options": {
      "enabled": false
    },
    "query_options": {
      "enabled": false,
      "strategy": "noop",
      "synonym_enabled": false
    },
    "rerank_provider": "noop"
  },
  "candidate": {
    "label": "v2 + Qwen3精排Top10",
    "index_version": "v2",
    "profile": "custom",
    "top_k": 10,
    "retrieval_options": {
      "mode": "hybrid",
      "vector_top_k": 20,
      "bm25_top_k": 20,
      "rrf_k": 10
    },
    "rerank_options": {
      "enabled": true,
      "top_n": 10
    },
    "evidence_options": {
      "enabled": false
    },
    "query_options": {
      "enabled": false,
      "strategy": "noop",
      "synonym_enabled": false
    },
    "rerank_provider": "qwen3"
  },
  "decision": {
    "min_primary_improvement": 0.001,
    "quality_guardrails": {
      "context_recall": {
        "min_delta": -0.02
      }
    },
    "cost_limits": {
      "max_p95_increase_ratio": 2.0,
      "max_model_calls_increase": 1.0
    },
    "max_failed_cases": 0
  }
