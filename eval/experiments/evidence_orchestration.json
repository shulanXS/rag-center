{
  "schema_version": "1.0",
  "experiment_id": "evidence_orchestration",
  "title": "v2证据编排统一对比实验",
  "target": "evidence_orchestration",
  "changed_fields": ["evidence_options.enabled"],
  "dataset": "eval/datasets/golden_basic_20.json",
  "suite": "basic",
  "primary_metric": "context_precision",
  "concurrency": 4,
  "ragas_concurrency": 4,
  "warmup_cases": 0,
  "timeout_seconds": 120,
  "shared_candidate_top_k": 20,
  "baseline": {
    "label": "v2 + Qwen3精排Top10",
    "index_version": "v2",
    "profile": "custom",
    "top_k": 10,
    "retrieval_options": {
      "mode": "hybrid",
      "vector_top_k": 20,
      "bm25_top_k": 20,
      "rrf_k": 10
    },
    "rerank_options": {"enabled": true, "top_n": 10},
    "evidence_options": {"enabled": false, "max_items": 10},
    "query_options": {
      "enabled": false,
      "strategy": "noop",
      "synonym_enabled": false
    },
    "rerank_provider": "qwen3"
  },
  "candidate": {
    "label": "v2 + Qwen3精排Top10 + 证据包",
    "index_version": "v2",
    "profile": "custom",
    "top_k": 10,
    "retrieval_options": {
      "mode": "hybrid",
      "vector_top_k": 20,
      "bm25_top_k": 20,
      "rrf_k": 10
    },
    "rerank_options": {"enabled": true, "top_n": 10},
    "evidence_options": {"enabled": true, "max_items": 10},
    "query_options": {
      "enabled": false,
      "strategy": "noop",
      "synonym_enabled": false
    },
    "rerank_provider": "qwen3"
  },
  "decision": {
    "min_primary_improvement": 0.001,
    "quality_guardrails": {
      "context_recall": {"min_delta": -0.02}
    },
    "cost_limits": {
      "max_p95_increase_ratio": 5.0,
      "max_model_calls_increase": 1.0
    },
    "max_failed_cases": 0
  }
