{
  "schema_version": "1.0",
  "experiment_id": "query_rewrite",
  "title": "Query Rewrite 消融实验",
  "target": "query_rewrite",
  "changed_fields": ["query_options.enabled"],
  "dataset": "eval/datasets/golden_basic_20.json",
  "suite": "basic",
  "primary_metric": "context_recall",
  "concurrency": 4,
  "ragas_concurrency": 4,
  "warmup_cases": 0,
  "timeout_seconds": 120,
  "baseline": {
    "label": "关闭 Query Rewrite",
    "index_version": "v1",
    "profile": "custom",
    "top_k": 5,
    "retrieval_options": {
      "mode": "vector",
      "vector_top_k": 10,
      "bm25_top_k": 10,
      "rrf_k": 60
    },
    "rerank_options": {"enabled": false, "top_n": 5},
    "evidence_options": {"enabled": false},
    "query_options": {
      "enabled": false,
      "strategy": "rewrite",
      "synonym_enabled": false
    }
  },
  "candidate": {
    "label": "开启 Query Rewrite",
    "index_version": "v1",
    "profile": "custom",
    "top_k": 5,
    "retrieval_options": {
      "mode": "vector",
      "vector_top_k": 10,
      "bm25_top_k": 10,
      "rrf_k": 60
    },
    "rerank_options": {"enabled": false, "top_n": 5},
    "evidence_options": {"enabled": false},
    "query_options": {
      "enabled": true,
      "strategy": "rewrite",
      "synonym_enabled": false
    }
  },
  "decision": {
    "min_primary_improvement": 0.03,
    "quality_guardrails": {
      "context_precision": {"min_delta": -0.02}
    },
    "cost_limits": {
      "max_p95_increase_ratio": 0.4,
      "max_model_calls_increase": 1.0
    },
    "max_failed_cases": 0
  }
}
