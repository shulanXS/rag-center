{
  "schema_version": "1.0",
  "experiment_id": "profile_balanced_vs_quality",
  "title": "Balanced 与 Quality Profile 对比实验",
  "target": "retrieve_profile",
  "changed_fields": [
    "profile",
    "top_k",
    "retrieval_options.vector_top_k",
    "retrieval_options.bm25_top_k",
    "rerank_options.enabled",
    "query_options.enabled"
  ],
  "dataset": "eval/datasets/golden_basic_20.json",
  "suite": "basic",
  "primary_metric": "context_recall",
  "concurrency": 4,
  "ragas_concurrency": 4,
  "warmup_cases": 0,
  "timeout_seconds": 120,
  "baseline": {
    "label": "balanced",
    "profile": "balanced",
    "top_k": 5,
    "retrieval_options": {
      "mode": "hybrid",
      "vector_top_k": 10,
      "bm25_top_k": 10,
      "rrf_k": 60
    },
    "rerank_options": {"enabled": false, "top_n": 5},
    "evidence_options": {"enabled": false},
    "query_options": {
      "enabled": false,
      "strategy": "rewrite",
      "synonym_enabled": false
    }
  },
  "candidate": {
    "label": "quality",
    "profile": "quality",
    "top_k": 8,
    "retrieval_options": {
      "mode": "hybrid",
      "vector_top_k": 20,
      "bm25_top_k": 20,
      "rrf_k": 60
    },
    "rerank_options": {"enabled": true, "top_n": 5},
    "evidence_options": {"enabled": false},
    "query_options": {
      "enabled": true,
      "strategy": "rewrite",
      "synonym_enabled": false
    }
  },
  "decision": {
    "min_primary_improvement": 0.03,
    "quality_guardrails": {
      "context_precision": {"min_delta": -0.02}
    },
    "cost_limits": {
      "max_p95_increase_ratio": 1.0,
      "max_model_calls_increase": 2.0
    },
    "max_failed_cases": 0
  }
}
